*-----------------------------------------------------------------------*
* SOIL NITROGEN data file for use with NPOTATO model (June 1996)        *
*                                                                       *
*-----------------------------------------------------------------------*
*
NTOT   =  65.          !  total soil mineral nitrogen
* initial mineral amounts of nitrogen in soil compartments in kg(N)/ha/layer
ANLAY  =    1.0,
            9.0,
           10.0,
           10.0,
           10.0,
            5.0,
            5.0,
            5.0,
            5.0,
            5.0
* number of nitrogen applications (maximum = 5)
INUMAP =    1
* timing of nitrogen applications. Day number at which application is
* given needs to be specified 
DAYN  =   200.
* the amounts of nitrogen (kg ha-1) in the applications need to be 
* specified for application 1, etc.
ANAP   =  0.
* nitrogen concentration in rainwater (kg/cm)
* nitrogen concentration of 0.5 kg/cm, and 800 mm annual precipitation
* means a yearly input of ca. 40 kg/ha
NCRAIN  =   0.2
* time constant for nitrogen diffusion (day)
TCND    =   10.
* adsorption coefficient for N
ADC     =    1.
* max. N-influx per cm2 root area
FMAX    =   100.
